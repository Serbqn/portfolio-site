# =========================================================================
# Serb Portfolio · env example
# Copy to .env.local and fill in the values.
# =========================================================================

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (Settings → API) — server-only, never expose
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Blob read/write token (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Optional · used for sitemap/robots/metadata. Defaults to https://www.serb.work
# NEXT_PUBLIC_SITE_URL=https://www.serb.work

# New-message Telegram notifications (@BotFather → /newbot → token; send /start
# to the bot, then read chat.id from api.telegram.org/bot<TOKEN>/getUpdates).
# Unset = form still works, just no ping.
# TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token
# TELEGRAM_CHAT_ID=123456789
